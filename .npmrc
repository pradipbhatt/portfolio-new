# Fewer extras during install (faster on slow disks)
fund=false
audit=false
# Prefer cache when possible (fewer registry round-trips; helps flaky DNS)
prefer-offline=true
# Mitigate EAI_AGAIN / slow registry on dual-stack (Node applies this to npm’s fetch)
node-options=--dns-result-order=ipv4first
# Less parallel network + extract (easier on slow / external volumes)
maxsockets=5
# Show lifecycle script output; one script at a time (less IO thrash on slow disks)
foreground-scripts=true
